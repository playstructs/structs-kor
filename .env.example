# ── Production (baked into the static build) ───────────────────────────────
# The guild whose Guild API, GRASS and Matrix this site uses by default.
VITE_GUILD_ID=0-5
VITE_GUILD_API=https://beta.playstructs.com/api
VITE_GRASS_URL=wss://beta.playstructs.com:1443
VITE_MATRIX_URL=https://matrix.beta.playstructs.com
# Only for what the Guild API cannot do yet (account sequence, tx broadcast). See docs/guild-api-requirements.md.
VITE_LCD_URL=https://public.testnet.structs.network
# Public origin of this site (canonical links). Pick one of the owned domains.
VITE_SITE_URL=https://xn--2e0b952cv5c.com
# Desktop app downloads (e.g. the GitHub releases page). Unset: the site never offers the desktop app.
# VITE_DESKTOP_RELEASES=https://github.com/<owner>/structs-kor/releases/latest

# "direct" (default for builds) or "relay" (default for `pnpm dev`): who carries the calls.
# VITE_TRANSPORT=relay

# ── Dev relay upstreams (vite.config.ts) ───────────────────────────────────
RELAY_GUILD_ORIGIN=https://beta.playstructs.com
RELAY_GRASS_ORIGIN=wss://beta.playstructs.com:1443
RELAY_LCD_ORIGIN=https://public.testnet.structs.network
RELAY_MATRIX_ORIGIN=https://matrix.beta.playstructs.com
