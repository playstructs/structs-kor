{
  "name": "structs-kor",
  "version": "0.2.0",
  "private": true,
  "description": "구조체 — the structs-webapp game client, built from the structs-webapp submodule with its text in Korean.",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "npm --prefix structs-webapp/src ci --no-audit --no-fund",
    "dev": "webpack serve --mode=development",
    "build": "webpack --mode=production",
    "audit:ko": "node ko/audit.cjs",
    "test": "node ko/audit.cjs --strict"
  },
  "devDependencies": {
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
